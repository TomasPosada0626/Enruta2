# Copia este archivo como .env (cp .env.example .env). Nunca subas .env al repo.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Docker Compose publica PostGIS en 15432 (ver docker-compose.yml).
DATABASE_URL=postgresql://enruta2:enruta2@localhost:15432/enruta2
REDIS_URL=redis://localhost:6379

# Correo con Resend (resend.com → API Keys). Sin clave, en desarrollo los correos se guardan
# como HTML en apps/api/tmp/correos. En producción las dos primeras son obligatorias.
# Sin MAIL_FROM se usa el remitente de prueba de Resend (solo entrega a tu propio correo).
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Enruta2 <no-responder@correo.tudominio>
# MAIL_REPLY_TO=soporte@tudominio
