  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "catalog:",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "catalog:"
  }
}
