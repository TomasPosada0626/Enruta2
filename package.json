{
  "name": "enruta2",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de rutas escolares para Colombia: orden óptimo de recogida, ubicación en vivo y hora estimada por parada.",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "routing:prepare": "node infra/routing/prepare.mjs",
    "routing:up": "docker compose --profile routing up -d osrm vroom",
    "routing:down": "docker compose --profile routing rm -sf osrm vroom",
    "routing:benchmark": "node infra/routing/benchmark.mjs",
    "movil": "pnpm --filter @enruta2/mobile start",
    "apk": "pnpm --filter @enruta2/mobile apk",
    "ota": "pnpm --filter @enruta2/mobile ota",
    "correo": "pnpm --filter @enruta2/api correo"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
